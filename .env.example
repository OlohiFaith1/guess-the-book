# Copy this file to .env (or .env.local) and fill in your Supabase project's
# values. Both are safe to expose in client-side code — the anon key is
# designed for this and is restricted by Row Level Security policies.
# See SUPABASE_SETUP.md for where to find these.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
